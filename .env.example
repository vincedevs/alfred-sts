# Copy to .env and fill in. Required: OPENAI_API_KEY, plus one Claude sign-in below.

OPENAI_API_KEY=

# Claude, for background jobs (Phase 2). Set ONE of these:
#   CLAUDE_CODE_OAUTH_TOKEN  your Claude plan (from `claude setup-token`); uses your plan's limits
#   ANTHROPIC_API_KEY        an API key from platform.claude.com; billed per use
# If both are set, the API key is likely used instead.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Background jobs (defaults shown)
ALFRED_AGENT_MODEL=claude-haiku-5-5
# A job stops if it would cost more than this (USD).
ALFRED_TASK_BUDGET_USD=0.25
# Where Alfred keeps its database and Claude's workspace folder.
ALFRED_DATA=~/.alfred

# Quiet hours: between these hours Alfred doesn't start talking on his own (job questions
# and results wait), except for reminders you set. "22-7" is 10 pm to 7 am; "off" for none.
ALFRED_QUIET_HOURS=22-7

# Where you are: Alfred assumes this place, these units and this currency unless you say otherwise.
ALFRED_HOME=Manila, Philippines
ALFRED_UNITS=metric
ALFRED_CURRENCY=Philippine pesos (PHP, ₱)
# Reminders, quiet hours and "now" use this time zone, whatever the computer is set to.
ALFRED_TIMEZONE=Asia/Manila

# Models (defaults shown)
ALFRED_LIVE_MODEL=gpt-live-1
ALFRED_ROUTER_MODEL=gpt-6-luna
# GPT-Live voice: vesper is the built-in British voice. Empty lets OpenAI choose.
ALFRED_VOICE=vesper

# Wake word: folder holding melspectrogram.onnx, embedding.onnx, hey_alfred.onnx.
# Empty uses the project's models/ folder.
ALFRED_WAKEWORD_DIR=
# 0 to 1. Raise it if Alfred wakes by mistake, lower it if it misses you.
ALFRED_WAKE_THRESHOLD=0.5

# Close the GPT-Live session after this many seconds with nobody speaking.
ALFRED_IDLE_SECONDS=25

# Audio devices: an index or part of a name from `uv run python -m sounddevice`.
# Empty uses the system default.
ALFRED_INPUT_DEVICE=
ALFRED_OUTPUT_DEVICE=

# Echo cancellation (plus noise suppression and gain control) on the mic: on or off.
# Off passes the raw mic audio on, for comparison.
ALFRED_ECHO_CANCELLATION=on

# What the terminal shows. DEBUG shows everything; INFO shows the conversation.
# Every run also writes a full DEBUG log to logs/.
ALFRED_LOG_LEVEL=INFO

# Email for Alfred to send (Phase 3), only after you approve it out loud.
# Use a Gmail app password (myaccount.google.com/apppasswords), never your real
# password. Paste the 16 characters without spaces, on one line.
ALFRED_EMAIL=
ALFRED_EMAIL_APP_PASSWORD=
